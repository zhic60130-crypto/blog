---
// 管理后台入口：/admin/
// Decap CMS 自托管（/admin/decap-cms.js，不依赖 CDN）；
// 配置唯一来源在 src/lib/cmsConfig.ts：
//   - dev（pnpm dev + npx decap-server）→ 注入 local_backend，免 OAuth 编辑本机文件
//   - 生产构建 → Gitea 后端（部署前在 cmsConfig.ts 填好 TODO）
import { getCmsConfig } from '../lib/cmsConfig'

const config = getCmsConfig(import.meta.env.DEV)
---
<!doctype html>
<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>内容管理 · 講評世界</title>
  </head>
  <body>
    <!-- 手动初始化标记：必须先于 decap-cms.js 加载，否则它会去找 config.yml 自动初始化 -->
    <script is:inline>
      // HTTP 非 localhost 环境下 crypto.randomUUID / crypto.subtle 不存在（安全上下文限制），
      // Decap 的 PKCE 登录流程两者都要用（randomUUID 生成 state，subtle.digest 算 SHA-256）。
      // 这里提供同规格 polyfill；HTTPS 部署后走浏览器原生实现。
      if (!window.crypto.randomUUID) {
        window.crypto.randomUUID = function () {
          const b = new Uint8Array(16)
          window.crypto.getRandomValues(b)
          b[6] = (b[6] & 0x0f) | 0x40
          b[8] = (b[8] & 0x3f) | 0x80
          const h = Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('')
          return h.slice(0, 8) + '-' + h.slice(8, 12) + '-' + h.slice(12, 16) + '-' + h.slice(16, 20) + '-' + h.slice(20)
        }
      }
      if (!window.crypto.subtle) {
        const K = [
          0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
          0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
          0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
          0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
          0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
          0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
          0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
          0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
        ]
        function sha256Bytes(bytes) {
          const H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
          const l = bytes.length
          const buf = new Uint8Array(((l + 8) >> 6 << 6) + 64)
          buf.set(bytes)
          buf[l] = 0x80
          const bdv = new DataView(buf.buffer)
          bdv.setUint32(buf.length - 4, l << 3)
          bdv.setUint32(buf.length - 8, Math.floor(l / 0x20000000))
          const w = new Uint32Array(64)
          for (let i = 0; i < buf.length; i += 64) {
            for (let j = 0; j < 16; j++) w[j] = bdv.getUint32(i + j * 4)
            for (let j = 16; j < 64; j++) {
              const s0 = ((w[j - 15] >>> 7) | (w[j - 15] << 25)) ^ ((w[j - 15] >>> 18) | (w[j - 15] << 14)) ^ (w[j - 15] >>> 3)
              const s1 = ((w[j - 2] >>> 17) | (w[j - 2] << 15)) ^ ((w[j - 2] >>> 19) | (w[j - 2] << 13)) ^ (w[j - 2] >>> 10)
              w[j] = (w[j - 16] + s0 + w[j - 7] + s1) >>> 0
            }
            let a = H[0], b = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7]
            for (let j = 0; j < 64; j++) {
              const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7))
              const ch = (e & f) ^ (~e & g)
              const t1 = (h + S1 + ch + K[j] + w[j]) >>> 0
              const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10))
              const maj = (a & b) ^ (a & c) ^ (b & c)
              const t2 = (S0 + maj) >>> 0
              h = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b; b = a; a = (t1 + t2) >>> 0
            }
            H[0] = (H[0] + a) >>> 0; H[1] = (H[1] + b) >>> 0; H[2] = (H[2] + c) >>> 0; H[3] = (H[3] + d) >>> 0
            H[4] = (H[4] + e) >>> 0; H[5] = (H[5] + f) >>> 0; H[6] = (H[6] + g) >>> 0; H[7] = (H[7] + h) >>> 0
          }
          const out = new Uint8Array(32)
          const odv = new DataView(out.buffer)
          for (let i = 0; i < 8; i++) odv.setUint32(i * 4, H[i])
          return out
        }
        window.crypto.subtle = {
          digest: async function () {
            const data = arguments.length > 1 ? arguments[1] : arguments[0].length !== undefined ? arguments[0] : null
            const bytes = data instanceof Uint8Array ? data : new Uint8Array(data)
            return sha256Bytes(bytes).buffer
          },
        }
      }
      window.CMS_MANUAL_INIT = true
    </script>
    <!-- is:inline：禁止 Astro/Vite 打包这个 UMD 包，必须原样输出才能挂到 window -->
    <script is:inline src="/admin/decap-cms.js"></script>
    <script is:inline define:vars={{ config }}>
      const CMSLib = window.CMS || window.DecapCMS
      CMSLib.init({ config })
    </script>
  </body>
</html>
