---
import { themeConfig } from '~/.config'
import SiteFooter from '~/components/SiteFooter.astro'
import SiteBackground from '~/components/SiteBackground.astro'
import SiteNavigation from '~/components/SiteNavigation.astro'
import SiteProfile from '~/components/SiteProfile.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LaTeX from '~/components/LaTeX.astro'
import Analytics from '~/components/Analytics.astro'
import ThemeScript from '~/components/ThemeScript.astro'
import '~/styles/global.css'

const lang = themeConfig.appearance.locale ?? 'en-us'
const dark = themeConfig.appearance.theme === 'dark'
---

<html lang={lang} class:list={['animation-prepared', { dark }]}>
  <head>
    <slot name="seo"> <SiteSeo /> </slot>
    <LaTeX />
    <Analytics />
    <ThemeScript />
  </head>

  <body
    class="h-100vh max-w-1200px min-w-390px mx-a"
    p="7.5 lg:(y-0 x-20)"
    lg="grid gap-x-6 cols-[3fr_2fr] rows-[1fr_9rem]"
  >
    <SiteBackground />
    <header
      class="transition-swup-header flex flex-col gap-2.5"
      m="7.5 lg:(x-0 t-20 b-4)"
      lg="row-1-2 col-2-3 items-start gap-6"
    >
      <!-- 竖排标题已按用户要求移除，简介顶替其位置 -->
      <SiteProfile />
      <SiteNavigation />
    </header>

    <main class="transition-swup-main overflow-y-scroll scrollbar-hide outline-none" lg="row-1-3 col-1-2 py-20 pl-12">
      <slot />
    </main>

    <footer class="transition-swup-footer py-7.5" lg="row-2-3 col-2-3">
      <SiteFooter />
    </footer>

    <script>
      // 点击导航后重放与进站同款的入场特效（原站没有，用户要求加）。
      // 进出场/连点中断处理参考原站实测：
      //  - swup:transition-start（leave 开始）立即移除类，取消重放动画，
      //    让 swup 原生 0.5s 出场淡出不被打架（与原站出场一致）
      //  - swup:page:view（新页渲染完）remove+reflow+add 重启动画，
      //    保证快速连点时每次新视图都能重放（重复加同一个类不会重启，必须 reflow）
      //  - 连点时 swup 自身保证「最后一次点击生效、类最终回到 swup-enabled」
      function removeAnimation() {
        document.documentElement.classList.remove('animation-prepared')
      }
      function replayEntrance() {
        const el = document.documentElement
        el.classList.remove('animation-prepared')
        void el.offsetWidth
        el.classList.add('animation-prepared')
      }
      const w = window as any
      if (!w.__entranceAnimHooked) {
        w.__entranceAnimHooked = true
        document.addEventListener('animationend', removeAnimation, false)
        document.addEventListener('swup:transition-start', removeAnimation)
        document.addEventListener('swup:page:view', replayEntrance)
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .transition-swup-header,
      html.animation-prepared .transition-swup-footer {
        animation: fade-in-down 1s linear 1;
        --at-apply: 'lg-animate-name-fade-in-left';
      }

      html.animation-prepared .transition-swup-main {
        animation: fade-in-down 1s linear 1;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-1rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @keyframes fade-in-left {
        0% {
          opacity: 0;
          transform: translateX(1rem);
        }

        100% {
          opacity: 1;
          transform: translateX(0);
        }
      }

      /* 页面过渡动画 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(-1rem);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(1rem);
      }
      .transition-swup-main {
        transition-duration: 0.5s;
        transition-timing-function: linear;
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </body>
</html>
