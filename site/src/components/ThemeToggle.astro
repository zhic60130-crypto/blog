---
// 右上角扇形暗/亮切换按钮：四分之一圆贴住视口右上角，点击扇形任意位置切换。
// 切换与记忆逻辑在 ThemeScript.astro 的 <head> 内联脚本里（事件委托，swup 换页不失效）。
---

<button
  type="button"
  data-theme-toggle
  aria-label="切换暗/亮模式"
  title="切换暗/亮模式"
  class="theme-fan"
>
  <span class="icon i-mdi-weather-night dark:hidden"></span>
  <span class="icon i-mdi-white-balance-sunny hidden dark:block"></span>
</button>

<style>
  .theme-fan {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 2;
    /* 80px 扇形：右上角贴角但不遮背景纸飞机（飞机在离右缘 45~115px、y≈90 起） */
    width: 5rem;
    height: 5rem;
    padding: 0;
    border: none;
    cursor: pointer;
    /* 左下角 100% 圆角 = 以右上角为圆心的四分之一圆扇形 */
    border-radius: 0 0 0 100%;
    background: rgb(255 255 255 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: -2px 2px 10px rgb(0 0 0 / 0.07);
    transition:
      width 0.25s ease,
      height 0.25s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .theme-fan:hover {
    width: 5.75rem;
    height: 5.75rem;
    background: rgb(255 255 255 / 0.8);
  }

  .theme-fan:focus-visible {
    outline: 2px solid rgb(0 0 0 / 0.35);
    outline-offset: -2px;
  }

  :global(.dark) .theme-fan {
    background: rgb(25 22 20 / 0.55);
    box-shadow: -2px 2px 10px rgb(0 0 0 / 0.35);
  }

  :global(.dark) .theme-fan:hover {
    background: rgb(25 22 20 / 0.8);
  }

  :global(.dark) .theme-fan:focus-visible {
    outline-color: rgb(255 255 255 / 0.45);
  }

  .icon {
    position: absolute;
    top: 1.35rem;
    right: 1.35rem;
    width: 1.5rem;
    height: 1.5rem;
    color: rgb(68 63 60);
    transition: transform 0.3s ease;
  }

  .theme-fan:hover .icon {
    transform: rotate(18deg) scale(1.1);
  }

  :global(.dark) .icon {
    color: rgb(214 211 209);
  }

  @media (max-width: 639px) {
    .theme-fan {
      width: 4rem;
      height: 4rem;
    }

    .icon {
      top: 1.05rem;
      right: 1.05rem;
      width: 1.2rem;
      height: 1.2rem;
    }
  }
</style>
