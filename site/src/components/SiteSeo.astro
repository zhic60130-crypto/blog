---
// 极简 head（用户要求）：移除全部社交/SEO 标签（og/twitter/canonical/description/generator）。
// 仅保留功能性标签：编码、视口、theme-color、标题、favicon/manifest、RSS 发现。
// title 来自文章 frontmatter（后台可填任意内容），转义后 set:html 输出防 head 注入。
import { themeConfig } from '~/.config'

interface Props {
  title?: string
  desc?: string
  banner?: ImageMetadata
}

const props = Astro.props
const configSite = themeConfig.site

const escapeHtml = (s: string) =>
  s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)

const title = escapeHtml(props.title ?? configSite.title)
const rss = new URL('/atom.xml', Astro.site).toString()
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
{themeConfig.seo.meta.filter((m) => m.name === 'theme-color').map((m) => <meta name={m.name} content={m.content} />)}
<title set:html={title} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={escapeHtml(configSite.title)} href={rss} />
{themeConfig.seo.link.map((l) => <link rel={l.rel} href={l.href} type={l.type} sizes={l.sizes} />)}
