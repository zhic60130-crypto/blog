</div>

<script>
  // 播放策略：任何路由的整页加载（首进/刷新）都播一次；
  // swup 跳转不重载本脚本（背景在 main 外持久存在）故不会每次跳转重播
  const stage = document.getElementById('charStage')
  if (stage) {
    stage.classList.add('play')
  }
</script>

<style>
  .bg-stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    color: var(--uno-colors-primary);
    overflow: hidden;
  }
  .bg-decor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.13;
  }
  .bg-note {
    font-size: 15px;
    letter-spacing: 0.12em;
    font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', 'DFKai-SB', cursive;
  }
  .bg-hand text {
    font-size: 17px;
    font-family: 'Segoe Script', 'Bradley Hand', 'Comic Sans MS', cursive;
  }

  /* 角色容器：桌面右下 */
  .char-wrap {
    --char-op: 0.14;
    position: absolute;
    right: -1%;
    bottom: 0;
    width: min(46vw, 680px);
    aspect-ratio: 1456 / 1080;
  }
  .char-wrap picture,
  .char-wrap img,
  .char-wrap svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 彩色位图：最终态 .14 */
  .char-color {
    opacity: var(--char-op);
  }

  /* 线稿：静止态完全淡出，只留干净彩图（避免与原图重叠） */
  .char-line {
    opacity: 0;
  }
  .char-line .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* ===== 播放态时间轴 ===== */
  #charStage.play .bg-decor {
    opacity: 0;
    animation: decor-in 0.6s ease 1.5s forwards;
  }
  #charStage.play .char-line {
    opacity: 0.4;
    /* 上色淡入后线稿完全淡出 */
    animation: char-settle 0.6s ease 2.2s forwards;
  }
  #charStage.play .char-line .line {
    stroke-dashoffset: 1;
  }
  #charStage.play #ears-hair .line {
    animation: char-draw 0.8s ease-out 0.1s forwards;
  }
  #charStage.play #face .line {
    animation: char-draw 0.8s ease-out 0.35s forwards;
  }
  #charStage.play #body .line {
    animation: char-draw 0.8s ease-out 0.6s forwards;
  }
  #charStage.play #plane .line {
    animation: char-draw 0.8s ease-out 1s forwards;
  }
  #charStage.play #details .line {
    animation: char-draw 0.8s ease-out 1.5s forwards;
  }
  #charStage.play .char-color {
    opacity: 0;
    animation: char-fade 0.7s ease 2.1s forwards;
  }

  @keyframes char-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes char-fade {
    to {
      opacity: var(--char-op);
    }
  }
  @keyframes char-settle {
    to {
      opacity: 0;
    }
  }
  @keyframes decor-in {
    to {
      opacity: 0.13;
    }
  }

  /* 移动端：缩小 + 右移 + 更淡 */
  @media (max-width: 767px) {
    .char-wrap {
      --char-op: 0.08;
      width: 80vw;
      right: -16%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #charStage.play .char-line .line {
      animation: none;
      stroke-dashoffset: 0;
    }
    #charStage.play .char-line,
    #charStage.play .char-color,
    #charStage.play .bg-decor {
      animation: none;
    }
    #charStage.play .char-line {
      opacity: 0;
    }
    #charStage.play .char-color {
      opacity: var(--char-op);
    }
    #charStage.play .bg-decor {
      opacity: 0.13;
    }
  }
</style>
