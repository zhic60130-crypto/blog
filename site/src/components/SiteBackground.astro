---
// 背景装饰 v4（纯淡入，按用户要求替换 v3 的线稿描画动画）：
//  0.0s 方格纸立即出现（global.css，无动画）
//  整页加载后，彩色人物与装饰层在 2s 内一起慢慢淡入至最终浓度，之后静止
//  播放策略：任何路由的整页加载（首进/刷新）都播一次；
//  swup 跳转不重载本脚本（背景在 main 外持久存在）故不会每次跳转重播
//  prefers-reduced-motion 环境同样播放淡入：纯 opacity 过渡（无位移/缩放），
//  属低刺激动效，全端行为一致（此前 reduce 分支直接跳到终态，导致桌面看不到入场）
---

<div id="charStage" class="bg-stage" aria-hidden="true">
  <!-- 装饰层：轨迹 / 小纸飞机 / 星芒 / 手写短句 -->
  <svg class="bg-decor" viewBox="0 0 1440 900" preserveAspectRatio="xMaxYMax slice">
    <g fill="none" stroke="currentColor" stroke-width="2">
      <path d="M1235 425 C 1285 405, 1310 362, 1348 318" stroke-dasharray="6 8" />
      <path d="M995 812 c 42 30, 92 20, 112 -12" stroke-dasharray="6 8" />
      <g transform="translate(1352 296) rotate(-18)">
        <path d="M0 18 L54 0 L21 31 L14 22 Z" fill="currentColor" stroke="none" opacity=".55" />
        <path d="M14 22 L18 35 L27 24" />
      </g>
      <path d="M1090 418 l6 14 14 6 -14 6 -6 14 -6 -14 -14 -6 14 -6 Z" fill="currentColor" stroke="none" opacity=".5" />
      <path d="M1372 584 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5 Z" fill="currentColor" stroke="none" opacity=".5" />
      <path d="M1428 644 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4 Z" fill="currentColor" stroke="none" opacity=".5" />
    </g>
    <g fill="currentColor" stroke="none">
      <text x="1078" y="34" class="bg-note">在复杂的世界里，保留一点简单。</text>
      <g class="bg-hand" transform="rotate(6 1290 210)">
        <text x="1256" y="196">Keep</text>
        <text x="1272" y="222">Writing</text>
        <text x="1250" y="248">Keep Thinking</text>
        <text x="1292" y="272">· · ·</text>
      </g>
      <text x="1030" y="298" class="bg-note">世界。</text>
      <text x="1100" y="882" class="bg-note">—— 在文字里，和更好的自己相遇。</text>
    </g>
  </svg>

  <!-- 角色层：彩色位图（线稿 SVG 已随描画动画一并移除） -->
  <div class="char-wrap">
    <picture>
      <source srcset="/bg-character.webp" type="image/webp" />
      <img class="char-color" src="/bg-character.png" alt="" width="1456" height="1080" />
    </picture>
  </div>
</div>

<script>
  // 播放策略：任何路由的整页加载（首进/刷新）都淡入一次；
  // swup 跳转不重载本脚本（背景在 main 外持久存在）故不会每次跳转重播
  const stage = document.getElementById('charStage')
  if (stage) {
    stage.classList.add('play')
  }
</script>

<style>
  .bg-stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    color: var(--uno-colors-primary);
    overflow: hidden;
    /* 整层 multiply：白色像素融入纸面（消白眉毛），彩色正常显色 */
    mix-blend-mode: multiply;
  }
  /* 暗色模式下 multiply 会把水印吞掉，改回正常混合 */
  :global(html.dark) .bg-stage {
    mix-blend-mode: normal;
  }
  .bg-decor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.18;
  }
  .bg-note {
    font-size: 15px;
    letter-spacing: 0.12em;
    font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', 'DFKai-SB', cursive;
  }
  .bg-hand text {
    font-size: 17px;
    font-family: 'Segoe Script', 'Bradley Hand', 'Comic Sans MS', cursive;
  }

  /* 角色容器：左上角露出式（用户指定） */
  .char-wrap {
    --char-op: 0.6;
    position: absolute;
    left: -6%;
    top: -6%;
    width: min(30vw, 440px);
    aspect-ratio: 1456 / 1080;
  }
  .char-wrap picture,
  .char-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 彩色位图：浓度由 --char-op 控制（multiply 在 .bg-stage 层生效） */
  .char-color {
    opacity: var(--char-op);
  }

  /* ===== 播放态：整体纯淡入（2s，人物与装饰同步） ===== */
  #charStage.play .char-wrap {
    animation: char-fade-in 2s ease both;
  }
  #charStage.play .bg-decor {
    animation: decor-in 2s ease both;
  }

  @keyframes char-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes decor-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.18;
    }
  }

  /* 移动端：更小 + 左上角露一点 + 更淡 */
  @media (max-width: 767px) {
    .char-wrap {
      --char-op: 0.3;
      width: 70vw;
      left: -18%;
      top: -3%;
    }
  }
</style>
