---
// 主题初始化：head 内联、首帧渲染前执行，避免暗色闪白。
// 优先级：localStorage（用户手动切换的结果）> 跟随系统（themeConfig 的 system）。
// 点击 [data-theme-toggle]（ThemeToggle 扇形按钮）切换并记忆，多标签页同步。
---

<script is:inline>
  (function () {
    // swup updateHead 会在每次换页重新执行本内联脚本，必须只注册一次监听，
    // 否则点击事件被多个监听器重复处理、主题切过去又切回来，表现为按钮失效
    if (window.__themeControlInit) return
    window.__themeControlInit = true

    var KEY = 'theme'
    var root = document.documentElement
    var changing = false

    function apply(mode) {
      root.classList.toggle('dark', mode === 'dark')
    }

    function systemMode() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }

    function savedMode() {
      try {
        return localStorage.getItem(KEY)
      } catch (e) {
        return null
      }
    }

    apply(savedMode() || systemMode())

    // 用户没手动选过时，跟随系统切换
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!savedMode()) apply(e.matches ? 'dark' : 'light')
    })

    // 委托监听：按钮被 swup 换页重渲染后依然有效。
    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('[data-theme-toggle]') : null
      if (!btn || changing) return
      var origin = btn
      var icons = btn.querySelectorAll('.icon')
      for (var i = 0; i < icons.length; i++) {
        if (icons[i].getClientRects().length) {
          origin = icons[i]
          break
        }
      }
      var rect = origin.getBoundingClientRect()
      var point = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 }
      var next = root.classList.contains('dark') ? 'light' : 'dark'
      try {
        localStorage.setItem(KEY, next)
      } catch (err) {}

      if (!document.startViewTransition) {
        apply(next)
        return
      }

      // 到最远角落的距离；使用视口坐标，页面滚动后仍然正确。
      var radius = Math.hypot(
        Math.max(point.x, window.innerWidth - point.x),
        Math.max(point.y, window.innerHeight - point.y)
      )
      root.style.setProperty('--theme-reveal-x', point.x + 'px')
      root.style.setProperty('--theme-reveal-y', point.y + 'px')
      changing = true
      root.classList.add('theme-transitioning')
      function cleanup() {
        root.classList.remove('theme-transitioning')
        root.style.removeProperty('--theme-reveal-x')
        root.style.removeProperty('--theme-reveal-y')
        changing = false
      }

      var transition
      try {
        // 浏览器保留旧页面快照，并渲染真实的新主题页面供圆形裁剪。
        transition = document.startViewTransition(function () { apply(next) })
      } catch (err) {
        apply(next)
        cleanup()
        return
      }

      transition.ready.then(function () {
        root.animate({
          clipPath: [
            'circle(0px at ' + point.x + 'px ' + point.y + 'px)',
            'circle(' + radius + 'px at ' + point.x + 'px ' + point.y + 'px)'
          ]
        }, {
          duration: 2000,
          easing: 'linear',
          fill: 'forwards',
          pseudoElement: '::view-transition-new(root)'
        })
      }).catch(function () {
        // 页面隐藏等情况可能跳过动画，主题切换仍由更新回调完成。
        transition.skipTransition()
      })
      transition.finished.then(cleanup, cleanup)
    })

    // 多标签页同步
    window.addEventListener('storage', function (e) {
      if (e.key === KEY && (e.newValue === 'light' || e.newValue === 'dark')) apply(e.newValue)
    })
  })()
</script>
